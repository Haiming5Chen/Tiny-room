<!-- A two-link arm whose elbow motor is written with a negative gear, so that it turns the elbow
     backwards: told +5 degrees, the elbow goes -5. Kept, deliberately wrong, for What's new's
     demonstration of the import check (ADR 0079), which names the fault when the arm is imported. -->
<mujoco model="Two-link arm, elbow wired backwards">
  <compiler angle="radian"/>
  <worldbody>
    <body name="base_link">
      <geom type="cylinder" size="0.08 0.025" pos="0 0 0.025" mass="2" rgba="0.3 0.33 0.36 1"/>
      <body name="upper_arm" pos="0 0 0.05">
        <joint name="shoulder" type="hinge" axis="0 1 0" range="-2 2"/>
        <geom type="box" size="0.025 0.025 0.15" pos="0 0 0.15" mass="1.5" rgba="0.85 0.55 0.2 1"/>
        <body name="forearm" pos="0 0 0.3">
          <joint name="elbow" type="hinge" axis="0 1 0" range="-2.5 2.5"/>
          <geom type="box" size="0.02 0.02 0.125" pos="0 0 0.125" mass="0.8" rgba="0.85 0.55 0.2 1"/>
          <body name="tool0" pos="0 0 0.25"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="shoulder_motor" joint="shoulder" kp="800" kv="40"/>
    <position name="elbow_motor" joint="elbow" kp="400" kv="20" gear="-1"/>
  </actuator>
</mujoco>
